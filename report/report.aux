\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Bootstrap analysis of visual sensitivity and prediction shifts under complementary swaps. Correct images yield significant accuracy and likelihood gains, and swapping images shifts over half of VQA answers to the partner's reference.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:vlm-image-use}{{4}{6}{Bootstrap analysis of visual sensitivity and prediction shifts under complementary swaps. Correct images yield significant accuracy and likelihood gains, and swapping images shifts over half of VQA answers to the partner's reference}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predictions across four representative complementary pairs and no-image controls. The model resolves binary presence when given images and reverts to full sentences without an image on most prompts, but misses references on counting and spatial pairs.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:vlm-qualitative}{{5}{6}{Predictions across four representative complementary pairs and no-image controls. The model resolves binary presence when given images and reverts to full sentences without an image on most prompts, but misses references on counting and spatial pairs}{figure.caption.10}{}}
