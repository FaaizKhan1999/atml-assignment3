\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Accuracy scaling across candidate budgets and token costs for fixed and adaptive policies. Self-consistency leaves a wide gap to oracle coverage, while adaptive stopping cuts token use with minimal accuracy loss.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ttc-compute-curves}{{6}{7}{Accuracy scaling across candidate budgets and token costs for fixed and adaptive policies. Self-consistency leaves a wide gap to oracle coverage, while adaptive stopping cuts token use with minimal accuracy loss}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Comparison of candidate aggregation and selection rules across mathematical and multimodal benchmarks. Single-candidate selection heuristics and shortest-response controls perform worse than standard majority voting, whereas confidence-weighted voting yields a statistically significant gain on MATH and modest point-estimate improvements on MathVista whose confidence intervals include or touch zero.}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:t3-methods}{{5}{7}{Comparison of candidate aggregation and selection rules across mathematical and multimodal benchmarks. Single-candidate selection heuristics and shortest-response controls perform worse than standard majority voting, whereas confidence-weighted voting yields a statistically significant gain on MATH and modest point-estimate improvements on MathVista whose confidence intervals include or touch zero}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Candidate generation versus selection failures and quartile-based signal discrimination. Errors shift from generation misses at small budgets to selection failures at larger budgets, where domain-matched confidence signals discriminate best.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ttc-failures-signals}{{7}{7}{Candidate generation versus selection failures and quartile-based signal discrimination. Errors shift from generation misses at small budgets to selection failures at larger budgets, where domain-matched confidence signals discriminate best}{figure.caption.13}{}}
\citation{aggarwal2023adaptiveconsistency}
\citation{usman2026visconf}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces End-to-end latency, token overhead, and accuracy for live single-pass, parallel, and iterative refinement decoding. Under strict generation budgets, naive parallel sampling and multi-turn self-revision increase computational latency and truncation rates without improving accuracy, as beneficial revisions are offset by self-induced corruptions.}}{8}{table.caption.14}\protected@file@percent }
\newlabel{tab:t3-live}{{6}{8}{End-to-end latency, token overhead, and accuracy for live single-pass, parallel, and iterative refinement decoding. Under strict generation budgets, naive parallel sampling and multi-turn self-revision increase computational latency and truncation rates without improving accuracy, as beneficial revisions are offset by self-induced corruptions}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Performance and stopping distributions of agreement- and quality-based adaptive early-stopping policies. Both adaptive policies halt at the minimum rollout threshold on a majority of question-order instances to cut average rollout counts by more than half, showing no statistically significant accuracy loss relative to full-budget voting except for a small drop under the quality-aware policy on MATH.}}{8}{table.caption.15}\protected@file@percent }
\newlabel{tab:t3-adaptive}{{7}{8}{Performance and stopping distributions of agreement- and quality-based adaptive early-stopping policies. Both adaptive policies halt at the minimum rollout threshold on a majority of question-order instances to cut average rollout counts by more than half, showing no statistically significant accuracy loss relative to full-budget voting except for a small drop under the quality-aware policy on MATH}{table.caption.15}{}}
