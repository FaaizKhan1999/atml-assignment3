\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Computational resource footprints, parameter efficiency, and weight-space displacement across fine-tuning regimes. Low-rank adaptation drastically reduces peak GPU memory and trainable parameter counts compared to full fine-tuning, though orthogonal projection introduces additional training latency and subspace precomputation overheads.}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:t1-resources}{{2}{4}{Computational resource footprints, parameter efficiency, and weight-space displacement across fine-tuning regimes. Low-rank adaptation drastically reduces peak GPU memory and trainable parameter counts compared to full fine-tuning, though orthogonal projection introduces additional training latency and subspace precomputation overheads}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Subspace update energy, relative update norm, and activation shift across layers. Unconstrained updates match the random-subspace baseline, whereas OPLoRA eliminates protected-subspace interference while inducing comparable activation shifts.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ft-diagnostics}{{2}{4}{Subspace update energy, relative update norm, and activation shift across layers. Unconstrained updates match the random-subspace baseline, whereas OPLoRA eliminates protected-subspace interference while inducing comparable activation shifts}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Qualitative human evaluation of generation coherence, formatting compliance, and failure modes across a small response sample. Unconstrained full fine-tuning reduces mean coherence by introducing severe repetition and unprompted mathematical framing, whereas L2-SP avoids severe repetition and low-rank adapters improve coherence while largely avoiding mathematical framing on general prompts, with zero inappropriate content observed across all conditions.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:t1-annotation}{{3}{4}{Qualitative human evaluation of generation coherence, formatting compliance, and failure modes across a small response sample. Unconstrained full fine-tuning reduces mean coherence by introducing severe repetition and unprompted mathematical framing, whereas L2-SP avoids severe repetition and low-rank adapters improve coherence while largely avoiding mathematical framing on general prompts, with zero inappropriate content observed across all conditions}{table.caption.6}{}}
