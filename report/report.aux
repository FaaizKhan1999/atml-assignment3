\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Multi-stage training trajectories and complementary-image swap penalties. Caption alignment reduces overall answer loss before rebounding, whereas instruction tuning sharply lowers answer loss and widens the correct-over-complementary likelihood gap.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:vlm-learning-curves}{{3}{5}{Multi-stage training trajectories and complementary-image swap penalties. Caption alignment reduces overall answer loss before rebounding, whereas instruction tuning sharply lowers answer loss and widens the correct-over-complementary likelihood gap}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Final stage-three evaluation under correct, complementary, mismatched, and no-image conditions. The model achieves its highest accuracy and lowest answer loss with the correct image compared to complementary or mismatched inputs, while removing the image causes the model to generate identical full-sentence responses per prompt, which reduces strict exact-match accuracy far more than lead-answer accuracy.}}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:t2-final}{{4}{5}{Final stage-three evaluation under correct, complementary, mismatched, and no-image conditions. The model achieves its highest accuracy and lowest answer loss with the correct image compared to complementary or mismatched inputs, while removing the image causes the model to generate identical full-sentence responses per prompt, which reduces strict exact-match accuracy far more than lead-answer accuracy}{table.caption.8}{}}
