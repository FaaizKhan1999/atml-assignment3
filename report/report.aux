\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Zero-shot benchmark evaluation across mathematical and general reasoning tasks. While full-parameter fine-tuning and L2-SP achieve the largest in-domain mathematical gains at the expense of specific reading comprehension skills, low-rank adapters—particularly higher-rank LoRA and OPLoRA—deliver substantial mathematical improvements alongside positive transfer to out-of-domain benchmarks.}}{3}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:t1-bench}{{1}{3}{Zero-shot benchmark evaluation across mathematical and general reasoning tasks. While full-parameter fine-tuning and L2-SP achieve the largest in-domain mathematical gains at the expense of specific reading comprehension skills, low-rank adapters—particularly higher-rank LoRA and OPLoRA—deliver substantial mathematical improvements alongside positive transfer to out-of-domain benchmarks}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Training dynamics, regularization, and the adaptation--retention trade-off. L2-SP restricts parameter drift without sacrificing Full FT's mathematical gains, whereas adapters prioritize out-of-domain generalization over peak target-task accuracy.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:ft-training-tradeoff}{{1}{3}{Training dynamics, regularization, and the adaptation--retention trade-off. L2-SP restricts parameter drift without sacrificing Full FT's mathematical gains, whereas adapters prioritize out-of-domain generalization over peak target-task accuracy}{figure.caption.3}{}}
